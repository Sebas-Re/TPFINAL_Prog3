<?xml version="1.0" encoding="utf-8"?>

<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2"/>
    <!-- Sin el header X-AspNet-Version: no anunciar la versión exacta del framework. -->
    <httpRuntime targetFramework="4.7.2" enableVersionHeader="false"/>
    <!-- Cookies fuera del alcance de JavaScript y sin enviarse en requests de otros sitios.
         En un servidor con HTTPS conviene sumar requireSSL="true". -->
    <httpCookies httpOnlyCookies="true" sameSite="Lax"/>
    <sessionState cookieSameSite="Lax"/>
    <!-- Los visitantes remotos ven un error genérico, sin stack trace. -->
    <customErrors mode="RemoteOnly"/>
    <!-- Precios como "$ 7.300" y fechas dd/MM/yyyy sin depender de la configuración del servidor. -->
    <globalization culture="es-AR" uiCulture="es-AR" fileEncoding="utf-8"/>
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering removeServerHeader="true"/>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="X-Frame-Options" value="DENY"/>
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin"/>
        <!-- 'unsafe-inline' en scripts lo necesita WebForms (__doPostBack, validadores) y los
             onclick/onerror del markup; el resto queda limitado al propio sitio. Las imágenes
             pueden venir de http(s) porque el admin puede cargar URLs externas. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"/>
      </customHeaders>
    </httpProtocol>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Inicio.aspx"/>
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".woff"/>
      <mimeMap fileExtension=".woff" mimeType="font/woff"/>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
    </staticContent>
  </system.webServer>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"></add>
  </appSettings>
</configuration>
